# Low-bandwidth variant: package a wasihost binary and a component built outside Docker.
#   docker build -f src/syntheticservicep3/Dockerfile.prebuilt -t <ref> target/p3-image
# target/p3-image must hold `wasihost` (linux, node arch) and `synthetic.wasm`; the host
# compiles the component at start-up instead of loading a precompiled .cwasm.
FROM mirror.gcr.io/debian:bookworm-slim
COPY wasihost /app/wasihost
COPY synthetic.wasm /app/synthetic.wasm
USER 65534
ENV PORT="50055"
EXPOSE 50055
ENTRYPOINT ["/app/wasihost", "/app/synthetic.wasm"]
